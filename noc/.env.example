# ============================================================
# Homelab NOC 配置模板
# 用法：cp .env.example .env   然后按需修改
# .env 已被 .gitignore 忽略，不会进仓库。
#
# 只填地址和账号密码；设备清单、端口接线、拓扑文字属于"站点布局"，
# 放在 config.local.json（模板见 config.example.json）。
# ============================================================

# ---------- iKuai 主路由 ----------
# 后台地址（注意协议与端口，https 通常带非标端口）
IKUAI_URL=https://192.168.X.1
IKUAI_USER=admin
IKUAI_PASS=YOUR_ROUTER_PASSWORD_HERE

# ---------- PVE 宿主机 ----------
PVE_URL=https://192.168.X.10:8006
PVE_USER=root@pam
PVE_PASS=YOUR_PVE_PASSWORD_HERE
# PVE 节点名，默认 pve（在 PVE 网页 URL 里能看到）
PVE_NODE=pve

# ---------- 交换机（水星 SE106P 等 TP-Link 系网页管理）----------
SWITCH_URL=http://192.168.X.3
SWITCH_USER=admin
SWITCH_PASS=YOUR_SWITCH_PASSWORD_HERE

# ---------- 远程飞牛 NAS（经 VPN SSH 采集）----------
# 算力页会多一张卡片，展示远程 fnOS 的 CPU/内存/磁盘/温度。
# host 为空时静默跳过；VPN 断时前端显示「离线」。
# 卡片标题（可能是地名）写在 config.local.json 的 site.compute.fnos
FNOS_HOST=192.168.X.4
FNOS_PORT=22
FNOS_USER=your_user
FNOS_PASS=YOUR_REMOTE_FNOS_PASSWORD_HERE

# ---------- 远程爱快（VPN 站点的 iKuai，API 采集）----------
# 经 VPN 可达的远程路由器。算力页多一张卡片展示 CPU/内存/在线数/连接数/速率。
# 地址填 VPN 隧道地址（如 10.8.8.X），隧道断时前端显示「离线」
RIKUAI_URL=https://10.8.8.X
RIKUAI_USER=admin
RIKUAI_PASS=YOUR_REMOTE_IKUAI_PASSWORD_HERE

# ---------- 远程群晖备份监控（VPN 站点上跑的页面，反向代理嵌入 NOC）----------
# 经 VPN 可达的远程备份监控页面。NOC 加一个「备份」页签，用 iframe + 反向代理
# 把这个页面嵌进来。url 为空时禁用代理，页签显示「未配置」。
BKP_URL=http://192.168.X.4:8899

# ---------- 小米路由器（AP 模式）----------
# 多台 AP 共用同一组账号密码；各自的地址写在 config.local.json 的 wifi.hosts
MIWIFI_USER=admin
MIWIFI_PASS=YOUR_AP_PASSWORD_HERE

# ---------- Home Assistant ----------
HA_URL=http://192.168.X.20:8123
# 推荐用长期访问令牌：HA 网页 → 点右上角头像 → 安全 → 长期访问令牌 → 创建
# 填了 TOKEN 就不再走账号密码流程，也不会往 HA_TOKEN_FILE 里写 refresh_token
HA_TOKEN=YOUR_HA_LONG_LIVED_TOKEN_HERE
# 不用令牌时才填账号密码（仅用于首次换取 refresh_token）
HA_USER=
HA_PASS=YOUR_HA_PASSWORD_HERE
# refresh_token 落盘位置（容器内路径，对应 docker-compose 的 ./data:/data，勿删）
HA_TOKEN_FILE=/data/ha_token.json

# ---------- NAS 采集端 ----------
# 极空间等 NAS 上跑的 nas-net-agent 用它上报，必须与采集端 NOC_TOKEN 一致
# 生成：python -c "import secrets;print(secrets.token_hex(16))"
NAS_REPORT_TOKEN=
# NAS 的地址，用于从网关流量里扣掉它的外网部分，算出纯二层流量
NAS_IP=192.168.X.30
# 超过多少秒没收到上报就判定采集端掉线
NAS_STALE=45

# ---------- 服务 ----------
PORT=8940
HOST=0.0.0.0

# ---------- 本地站点配置 ----------
# 不填则依次找 /data/config.local.json、app/../config.local.json、./config.local.json
# NOC_LOCAL_CONFIG=/data/config.local.json

# ---------- 采集节奏（秒）----------
POLL_FAST=2
POLL_DEVICES=5
POLL_PVE=5
# 远程飞牛（经 VPN），不要太频繁
POLL_FNOS=15
# 远程爱快（经 VPN）
POLL_RIKUAI=15
POLL_PING=10
POLL_SWITCH=3
POLL_MIWIFI=10
POLL_HA=15
# 拨入站点（VPN 客户端）状态，站点点名在 config.local.json 的 vpn.clients
POLL_VPN=15
# 全量 ICMP 探测终端墙上的设备（iKuai 漏报时兜底）
POLL_LANPING=15
LAN_PING=1

# ---------- 安防监控（go2rtc） ----------
# go2rtc 通常和 NOC 在同一台机器，走回环即可；摄像头清单写在 config.local.json 的 cameras 段
CAM_URL=http://127.0.0.1:1984
# 网格快照轮询间隔（毫秒）；放大画面走 fMP4 实时流，不受这个值影响
CAM_SNAP_MS=2000

# ---------- 终端上下线判定 ----------
# 网关的"在线"不等于真的在线（同网段流量不经网关），所以：
# 消失多久才认离线（有 ICMP 探活 + AP 客户端表兜底，可以放宽）
DEV_GRACE=45
# 同一设备上下线事件的最小间隔
DEV_REPEAT=180

# ---------- 历史 ----------
# 2s 一个点 × 1800 = 1 小时
HISTORY_POINTS=1800
