# ============================================================
# 运维脚本（scripts/）的连接参数
# 用法：cp .env.example .env   然后填写
# .env 已被 .gitignore 忽略，不会进仓库。
#
# 这些只给 scripts/*.py 用；看板本体（noc/、monitor/）各用自己的 .env，
# 见 noc/.env.example 与 monitor/.env.example。
# ============================================================

# ---------- SSH ----------
# 大多数脚本走 SSH 执行命令，缺这一项会直接报错退出
SSH_PASSWORD=YOUR_SSH_PASSWORD_HERE
# 通用登录用户名（各设备若不同，用下面更具体的项覆盖）
SSH_USER=root

# ---------- 设备地址 ----------
# 看板中心（fnOS）
FNLAB_HOST=192.168.X.X
FNLAB_USER=
# Proxmox 宿主机
PVE_HOST=192.168.X.X
PVE_USER=root
PVE_NODE=pve
# 另一台 fnOS（跨网段那台）
FNNAS_HOST=192.168.X.X
FNNAS_USER=
# WireGuard 服务端
WG_HOST=192.168.X.X
WG_USER=root

# ---------- 旧看板（monitor）HTTP ----------
# 内网地址
CENTER_URL=http://192.168.X.X:8930
# 公网入口，没有就留空
PUBLIC_URL=
# 面板 Basic Auth
MONITOR_AUTH_USER=admin
MONITOR_AUTH_PASS=YOUR_MONITOR_PASSWORD_HERE
# 管理令牌（X-Admin-Token 头）
MONITOR_ADMIN_TOKEN=
# 设备上报令牌：全屋所有采集端共用这一对命名更清楚
MONITOR_DEVICE_TOKEN=
# 两台采集端各自的令牌
MONITOR_TOKEN_CENTER=
MONITOR_TOKEN_REMOTE=
# 默认设备名与型号
MONITOR_DEVICE_NAME=
MONITOR_DEVICE_MODEL=

# ---------- WireGuard ----------
# 公网端点：域名或公网 IP + 端口
WG_ENDPOINT=YOUR_DDNS_DOMAIN:51888
WG_PORT=51888
# 隧道网段
WG_NET=10.88.0.0/24
WG_SRV_IP=10.88.0.1
WG_PHONE_IP=10.88.0.2
WG_NAS_IP=10.88.0.3
WG_PC_IP=10.88.0.4
# 服务端背后的内网网段（要下发给客户端）
WG_LAN=192.168.X.0/24
# 对端 NAS 的单机路由，没有就留空
WG_NAS_LAN=
